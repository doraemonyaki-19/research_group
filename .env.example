# Copy this file to `.env` (in repo root) and fill in your keys.
# The .env file is auto-loaded by benchmarks/run_ablation.py; it is gitignored.
#
# Auth precedence (highest wins):
#   1. --api-key CLI argument to run_ablation.py
#   2. Provider-specific env var (ANTHROPIC_API_KEY, GEMINI_API_KEY, NVIDIA_API_KEY)
#   3. .env file in repo root (this one)

ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here
NVIDIA_API_KEY=nvapi-your-key-here
